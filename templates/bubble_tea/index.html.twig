{% extends '_catalog_form.html.twig' %}

{% set heading = 'Add a new drink' %}
{% set form_class = 'bubble-tea-form' %}
{% set back_url = path('app_explore', {tab: 'drinks'}) %}
{% set back_label = 'Back to Explore' %}
{% set introduction = 'Found something the catalog doesn’t have yet? Tell us about the drink.' %}
{% set submit_label = 'Save' %}

{% block panels %}
    <section class="catalog-form-panel rows">
        <h2 class="profile-label">Basics</h2>
        {{ form_row(form.name, {
            label: 'Drink name',
            row_attr: {class: 'form-input'}
        }) }}
        {{ form_row(form.description, {row_attr: {class: 'form-input'}}) }}
    </section>

    {% include 'catalog/_photo_upload.html.twig' with {field: form.photo} only %}
{% endblock %}
