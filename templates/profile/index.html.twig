{% extends 'base.html.twig' %}

{% block title %}Home · boba diary{% endblock %}

{% block body %}
  {{ parent() }}
    <main class="diary-main">
        <section class="diary-greeting" aria-labelledby="greeting-title">
            <h1 id="greeting-title">Evening, {{ app.user.name }}! </h1>
            <div class="diary-greeting-actions">
                <a class="btn btn-secondary" href="#recently-sipped">Open my journal</a>
            </div>
        </section>
        <section class="diary-recent" id="recently-sipped" aria-labelledby="recent-title">
            <div class="diary-section-heading">
                <div class="diary-section-title">
                    <h2 id="recent-title">Recently sipped</h2>
                    {# <span class="diary-entry-count">{bubbleTea|lenght}</span> #}
                </div>
                <a class="diary-all-entries" href="#recently-sipped">All entries <span aria-hidden="true">→</span></a>
            </div>
            <div class="diary-entry-grid">
                {% for bubbleTea in bubbleTeas %}
                    {% include 'profile/_entry_card.html.twig' with { 'bubbleTea': bubbleTea } %}
                    {% else %}
                    <p>You didn't add any bubble tea</p>
                {% endfor %}
            </div>
        </section>
    </main>
{% endblock %}
