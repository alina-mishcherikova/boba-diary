<li class="profile-added-row">
    {% include '_photo.html.twig' with {url: bubbleTea.imageUrl, class: 'profile-added-photo'} only %}
    <div class="profile-added-info">
        <h3>{{ bubbleTea.name }}</h3>
        {% if bubbleTea.description %}
            <p class="profile-added-description drink-description">{{ bubbleTea.description }}</p>
        {% endif %}
    </div>
    <span class="profile-label profile-badge{{ bubbleTea.inactivatedAt ? ' profile-badge-inactive' : '' }}">
        {{ bubbleTea.inactivatedAt ? 'Inactive' : 'In catalog' }}
    </span>
    <time class="profile-label profile-muted" datetime="{{ bubbleTea.createdAt|date('c') }}">{{ bubbleTea.createdAt|date('d M', 'Europe/Paris') }}</time>
</li>
