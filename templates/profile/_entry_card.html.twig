{% set log = entry[0] %}
{% set image = log.photoUrl ?: entry.drinkImage %}
{% set iceLabels = {None: 'No ice', Less: 'Less ice', Normal: 'Regular ice'} %}
{% set temperatureLabels = {Cold: 'Cold', Lukewarm: 'Lukewarm', Hot: 'Hot'} %}
<article class="profile-entry">
    {% include '_photo.html.twig' with {url: image, class: 'profile-entry-photo'} only %}

    <div class="profile-entry-body">
        <h3>{{ entry.drinkName ?? 'Drink entry' }}</h3>
        {% if entry.storeName %}
            <p class="profile-label">{{ entry.storeName }}{% if entry.storeCity %} · {{ entry.storeCity }}{% endif %}</p>
        {% endif %}
        <div class="profile-rating-row">
            {% include '_pearl_rating.html.twig' with {rating: log.rating} only %}
            <time datetime="{{ log.consumedAt|date('c') }}">{{ log.consumedAt|date('d M', 'Europe/Paris') }}</time>
        </div>
        {% if log.note %}
            <p class="profile-note">“{{ log.note }}”</p>
        {% endif %}
        {% if log.sugarLevel or log.iceLevel or log.temperature %}
            <ul class="profile-chips" aria-label="Drink preferences">
                {% if log.sugarLevel %}
                    <li class="profile-chip profile-chip-accent">{{ log.sugarLevel.label()|replace({' %': '%'}) }} sugar</li>
                {% endif %}
                {% if log.iceLevel %}
                    <li class="profile-chip">{{ iceLabels[log.iceLevel.name] }}</li>
                {% endif %}
                {% if log.temperature %}
                    <li class="profile-chip">{{ temperatureLabels[log.temperature.name] }}</li>
                {% endif %}
            </ul>
        {% endif %}
    </div>
</article>
